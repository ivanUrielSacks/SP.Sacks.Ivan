<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8.0.60"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controladores.FormularioController"
      spacing="10" prefWidth="800" prefHeight="600">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <Label text="Gestión de Misiones Espaciales" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Formulario -->
    <GridPane hgap="10" vgap="10">
        <Label text="ID Misión:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtIdMision" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Destino:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDestino" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Presupuesto:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPresupuesto" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Duración (días):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDuracion" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Agencia:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboAgencia" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="250"/>

        <Label text="Tipo:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <HBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="1">
            <RadioButton fx:id="rbTripulada" text="Tripulada" onAction="#cambiarTipo"/>
            <RadioButton fx:id="rbNoTripulada" text="No tripulada" onAction="#cambiarTipo"/>
        </HBox>

        <Label text="Astronautas:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="txtAstronautas" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Dispositivo:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboDispositivo" GridPane.rowIndex="8" GridPane.columnIndex="1" prefWidth="250"/>
    </GridPane>

    <!-- Botones CRUD -->
    <HBox spacing="10">
        <Button text="Agregar" onAction="#agregarMision"/>
        <Button text="Modificar" onAction="#modificarMision"/>
        <Button text="Eliminar" onAction="#eliminarMision"/>
        <Button text="Limpiar" onAction="#limpiarCampos"/>
    </HBox>

    <!-- Tabla de misiones -->
    <TableView fx:id="tablaMisiones" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colDestino" text="Destino" prefWidth="120"/>
            <TableColumn fx:id="colPresupuesto" text="Presupuesto" prefWidth="120"/>
            <TableColumn fx:id="colDuracion" text="Duración" prefWidth="80"/>
            <TableColumn fx:id="colAgencia" text="Agencia" prefWidth="150"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Botones de funcionalidades adicionales -->
    <HBox spacing="10">
        <Button text="Ver misiones de alto presupuesto" onAction="#verAltoPresupuesto"/>
        <Button text="Ver presupuesto total" onAction="#verPresupuestoTotal"/>
    </HBox>
</VBox>